<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disk Cleanup Helper" Width="1200" Height="740" MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBg}"
        FontFamily="Segoe UI" FontSize="13" Foreground="#0F172A" UseLayoutRounding="True">
  <Window.Resources>
    <!-- theme colours: each T_xxxxxx is the light colour #xxxxxx; Theme.cs swaps them for the dark theme -->
    <SolidColorBrush x:Key="AppBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="T_FFFFFF" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="T_F8FAFC" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="T_F1F5F9" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="T_E2E8F0" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="T_CBD5E1" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="T_94A3B8" Color="#94A3B8"/>
    <SolidColorBrush x:Key="T_64748B" Color="#64748B"/>
    <SolidColorBrush x:Key="T_475569" Color="#475569"/>
    <SolidColorBrush x:Key="T_0F172A" Color="#0F172A"/>
    <SolidColorBrush x:Key="T_2563EB" Color="#2563EB"/>
    <SolidColorBrush x:Key="T_DBEAFE" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="T_EFF6FF" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="T_B91C1C" Color="#B91C1C"/>
    <SolidColorBrush x:Key="T_FCA5A5" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="T_FEF2F2" Color="#FEF2F2"/>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource T_FFFFFF}"/>
      <Setter Property="Foreground" Value="{DynamicResource T_0F172A}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource T_CBD5E1}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource T_F1F5F9}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#2563EB"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1D4ED8"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Go" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#16A34A"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#16A34A"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#15803D"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{DynamicResource T_B91C1C}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource T_FCA5A5}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource T_FEF2F2}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource T_FFFFFF}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderBrush" Value="{DynamicResource T_E2E8F0}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- the light/dark switch in the dark header -->
    <Style x:Key="HeaderBtn" TargetType="Button">
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,8" MinWidth="86">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#334155"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- standard controls drawn in the theme's colours -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" CornerRadius="4" Background="{DynamicResource T_CBD5E1}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="{DynamicResource T_94A3B8}"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="t" Property="Background" Value="{DynamicResource T_64748B}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" Margin="2">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{DynamicResource T_FFFFFF}" BorderBrush="{DynamicResource T_CBD5E1}" BorderThickness="1" CornerRadius="7">
              <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" Data="M0,0 L4,4 L8,0"
                    Stroke="{DynamicResource T_64748B}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T_94A3B8}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource T_0F172A}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter IsHitTestVisible="False" Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                <Border Background="{DynamicResource T_FFFFFF}" BorderBrush="{DynamicResource T_CBD5E1}" BorderThickness="1" CornerRadius="7"
                        Margin="0,4,0,0" Padding="4" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer>
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource T_0F172A}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="bd" Padding="8,6" CornerRadius="5" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource T_EFF6FF}"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource T_F1F5F9}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListView">
      <Setter Property="Background" Value="{DynamicResource T_FFFFFF}"/>
      <Setter Property="Foreground" Value="{DynamicResource T_0F172A}"/>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Foreground" Value="{DynamicResource T_475569}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Grid>
              <Border Background="{DynamicResource T_F8FAFC}" BorderBrush="{DynamicResource T_E2E8F0}" BorderThickness="0,0,0,1" Padding="6,6">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Border>
              <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Margin="0,0,-3,0" Cursor="SizeWE">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent"/>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource T_0F172A}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="bd" Background="Transparent" Padding="0,3" CornerRadius="5">
              <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource T_F8FAFC}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource T_DBEAFE}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource T_0F172A}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="17" Height="17" CornerRadius="4" BorderThickness="1.5" VerticalAlignment="Center"
                      BorderBrush="{DynamicResource T_94A3B8}" Background="{DynamicResource T_FFFFFF}">
                <Path x:Name="mark" Data="M3,7.5 L6.2,10.7 L11.5,4" Stroke="White" StrokeThickness="2" Visibility="Collapsed"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="#2563EB"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#2563EB"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#2563EB"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource T_FFFFFF}"/>
      <Setter Property="Foreground" Value="{DynamicResource T_0F172A}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource T_CBD5E1}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource T_0F172A}"/>
      <Setter Property="SelectionBrush" Value="#2563EB"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource T_FFFFFF}"/>
      <Setter Property="Foreground" Value="{DynamicResource T_0F172A}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource T_CBD5E1}"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Foreground" Value="{DynamicResource T_0F172A}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <!-- the tab's content takes its text colour from here -->
      <Setter Property="Foreground" Value="{DynamicResource T_0F172A}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="tb" Padding="14,9,14,7" Margin="0,0,6,0" BorderThickness="0,0,0,3" BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter x:Name="hdr" ContentSource="Header" HorizontalAlignment="Center"
                                TextElement.Foreground="{DynamicResource T_64748B}" TextElement.FontSize="14" TextElement.FontWeight="SemiBold"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="hdr" Property="TextElement.Foreground" Value="{DynamicResource T_0F172A}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="tb" Property="BorderBrush" Value="{DynamicResource T_2563EB}"/>
                <Setter TargetName="hdr" Property="TextElement.Foreground" Value="{DynamicResource T_0F172A}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource AppBg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0F172A" Padding="22,12" Tag="NoTheme">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="AppTitle" Text="Disk Cleanup Helper" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="WrapWithOverflow"/>
          <TextBlock x:Name="Tagline" Text="See what fills your disks and free up space safely. Nothing is deleted until you confirm." Foreground="#94A3B8" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Border Background="#1E293B" CornerRadius="10" Padding="16,8" Margin="10,0,0,0" MinWidth="150">
            <StackPanel>
              <TextBlock x:Name="StatFreeLabel" Text="C: FREE" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
              <TextBlock x:Name="StatFree" Text="-" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock x:Name="StatFreeSub" Text="" FontSize="11" Foreground="#94A3B8"/>
            </StackPanel>
          </Border>
          <Border Background="#1E293B" CornerRadius="10" Padding="16,8" Margin="10,0,0,0" MinWidth="150">
            <StackPanel>
              <TextBlock Text="MEMORY AVAILABLE" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
              <TextBlock x:Name="StatMem" Text="-" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock x:Name="StatMemSub" Text="" FontSize="11" Foreground="#94A3B8"/>
            </StackPanel>
          </Border>
          <Border Background="#1E293B" CornerRadius="10" Padding="16,8" Margin="10,0,0,0" MinWidth="150">
            <StackPanel>
              <TextBlock Text="SELECTED TO CLEAN" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
              <TextBlock x:Name="StatSel" Text="0 items" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock x:Name="StatSelSub" Text="nothing selected" FontSize="11" Foreground="#94A3B8"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnLang" Style="{StaticResource HeaderBtn}" Margin="10,0,0,0">
            <StackPanel>
              <Path Width="20" Height="20" Stretch="Uniform" Stroke="White" StrokeThickness="1.8" HorizontalAlignment="Center"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M12 2A10 10 0 1 1 12 22A10 10 0 1 1 12 2Z M2 12H22 M12 2A15.3 15.3 0 0 1 16 12A15.3 15.3 0 0 1 12 22A15.3 15.3 0 0 1 8 12A15.3 15.3 0 0 1 12 2Z"/>
              <TextBlock x:Name="LangLabel" Text="English" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,7,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnTheme" Style="{StaticResource HeaderBtn}" Margin="10,0,0,0">
            <StackPanel>
              <Path x:Name="ThemeIcon" Width="20" Height="20" Stretch="Uniform" Stroke="White" StrokeThickness="1.8"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center"/>
              <TextBlock x:Name="ThemeLabel" Text="DARK MODE" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,7,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1">
      <Border x:Name="UpdateBar" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1" Padding="22,6" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="UpdateBarText" VerticalAlignment="Center" Foreground="#1E3A8A" TextWrapping="Wrap" FontWeight="SemiBold"/>
          <Button x:Name="BtnUpdateRestart" Grid.Column="1" Style="{StaticResource Primary}" Content="Restart now" Padding="12,4" Margin="14,0,0,0"/>
          <Button x:Name="BtnUpdateNotes" Grid.Column="2" Style="{StaticResource Btn}" Content="What's new" Padding="12,4" Margin="8,0,0,0"/>
          <Button x:Name="BtnUpdateLater" Grid.Column="3" Style="{StaticResource Btn}" Content="Later" Padding="12,4" Margin="8,0,0,0"/>
        </Grid>
      </Border>

      <Border x:Name="InstallBar" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1" Padding="22,6" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="InstallBarText" VerticalAlignment="Center" Foreground="#1E3A8A" TextWrapping="Wrap"
                     Text="Keep Disk Cleanup Helper on this PC: install it to open it from the Start menu and the desktop. No admin rights needed."/>
          <Button x:Name="BtnInstallBar" Grid.Column="1" Style="{StaticResource Primary}" Content="Install on this PC" Padding="12,4" Margin="14,0,0,0"/>
        </Grid>
      </Border>
    </StackPanel>

    <Border x:Name="AdminBanner" Grid.Row="2" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="0,0,0,1" Padding="22,7" Visibility="Collapsed">
      <TextBlock Foreground="#92400E" TextWrapping="Wrap" Text="Not running as administrator, so items marked Admin are disabled. To use them, close this window, start it again and click Yes on the Windows prompt."/>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="3" Margin="18,8,18,0">

      <TabItem Header="Clean up">
        <Grid Margin="4,12,4,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnScan" Style="{StaticResource Primary}" Content="Measure sizes"/>
            <Button x:Name="BtnStop" Style="{StaticResource Btn}" Content="Stop" IsEnabled="False"/>
            <Button x:Name="BtnSafe" Style="{StaticResource Btn}" Content="Select all safe"/>
            <Button x:Name="BtnNone" Style="{StaticResource Btn}" Content="Clear selection"/>
            <Button x:Name="BtnClean" Style="{StaticResource Go}" Content="Clean selected"/>
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="14,0,0,0" Foreground="#64748B" FontSize="12" MinWidth="300" Text="Click Measure sizes to see how much each item uses."/>
          </Grid>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
              <StackPanel x:Name="ListPanel"/>
            </ScrollViewer>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="18,16">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock x:Name="DetTitle" Text="Click an item" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="DetSize" Text="to see what it is, where it is, and what you keep or lose." Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
                  <StackPanel x:Name="DetBody"/>
                </ScrollViewer>
                <Button x:Name="BtnOpen" Grid.Row="2" Style="{StaticResource Btn}" Content="Open location" HorizontalAlignment="Left" Margin="0" IsEnabled="False"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Analyze disk">
        <Grid Margin="4,12,4,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="Drive" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#475569"/>
            <ComboBox x:Name="CmbDrive" Width="260" Height="32" Margin="0,0,16,6" VerticalContentAlignment="Center"/>
            <TextBlock Text="Look in" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#475569"/>
            <ComboBox x:Name="CmbScope" Width="190" Height="32" Margin="0,0,16,6" VerticalContentAlignment="Center"/>
            <TextBlock Text="List files bigger than" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#475569"/>
            <ComboBox x:Name="CmbMin" Width="90" Height="32" Margin="0,0,16,6" VerticalContentAlignment="Center"/>
            <Button x:Name="BtnAnalyze" Style="{StaticResource Primary}" Content="Scan" Margin="0,0,8,6"/>
            <Button x:Name="BtnStop2" Style="{StaticResource Btn}" Content="Stop" IsEnabled="False" Margin="0,0,8,6"/>
          </WrapPanel>
          <Grid Grid.Row="1" Margin="0,6,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress2" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText2" Grid.Column="1" Margin="14,0,0,0" Foreground="#64748B" FontSize="12" MinWidth="300" Text="Pick a drive and click Scan. A whole drive can take a few minutes."/>
          </Grid>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,6,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Biggest folders" FontSize="15" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,8,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BtnUp" Style="{StaticResource Btn}" Content="Up" Padding="10,4" IsEnabled="False"/>
                  <TextBlock x:Name="FolderPath" Grid.Column="1" VerticalAlignment="Center" Foreground="#475569" TextTrimming="CharacterEllipsis" Text="Scan a drive to see its biggest folders."/>
                </Grid>
                <ListView x:Name="FoldersList" Grid.Row="2" BorderThickness="0" SelectionMode="Single" ScrollViewer.CanContentScroll="False">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="Size" Width="85" DisplayMemberBinding="{Binding SizeText}"/>
                      <GridViewColumn Header="" Width="125">
                        <GridViewColumn.CellTemplate>
                          <DataTemplate>
                            <Grid Width="110" Height="8">
                              <Border Background="{DynamicResource T_E2E8F0}" CornerRadius="4"/>
                              <Border Background="{DynamicResource T_2563EB}" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                            </Grid>
                          </DataTemplate>
                        </GridViewColumn.CellTemplate>
                      </GridViewColumn>
                      <GridViewColumn Header="%" Width="50" DisplayMemberBinding="{Binding PctText}"/>
                      <GridViewColumn Header="Folder" Width="260" DisplayMemberBinding="{Binding Name}"/>
                    </GridView>
                  </ListView.View>
                </ListView>
                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                  <Button x:Name="BtnOpenFolder" DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="Open in File Explorer"/>
                  <TextBlock VerticalAlignment="Center" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Text="Double-click a folder to look inside."/>
                </DockPanel>
              </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12" Margin="6,0,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="FilesTitle" Text="Biggest files" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListView x:Name="FilesList" Grid.Row="1" BorderThickness="0" SelectionMode="Extended" ScrollViewer.CanContentScroll="False">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="Size" Width="85" DisplayMemberBinding="{Binding SizeText}"/>
                      <GridViewColumn Header="File" Width="190" DisplayMemberBinding="{Binding Name}"/>
                      <GridViewColumn Header="Modified" Width="90" DisplayMemberBinding="{Binding ModifiedText}"/>
                      <GridViewColumn Header="Folder" Width="300" DisplayMemberBinding="{Binding Folder}"/>
                    </GridView>
                  </ListView.View>
                </ListView>
                <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                  <Button x:Name="BtnFileOpen" Style="{StaticResource Btn}" Content="Open location" Margin="0,0,8,4"/>
                  <Button x:Name="BtnFileRecycle" Style="{StaticResource Btn}" Content="Move to Recycle Bin" Margin="0,0,8,4"/>
                  <Button x:Name="BtnFileDelete" Style="{StaticResource Danger}" Content="Delete permanently" Margin="0,0,8,4"/>
                </WrapPanel>
                <TextBlock Grid.Row="3" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Hold Ctrl to select several files. Windows and program files are protected and cannot be deleted here."/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Disk health">
        <Grid Margin="4,12,4,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <WrapPanel>
            <Button x:Name="BtnHealth" Style="{StaticResource Primary}" Content="Check disks again" Margin="0,0,8,6"/>
            <Button x:Name="BtnChkdsk" Style="{StaticResource Btn}" Content="Scan for errors" Margin="0,0,8,6"/>
            <Button x:Name="BtnOptimize" Style="{StaticResource Btn}" Content="Optimize drives" Margin="0,0,8,6"/>
            <Button x:Name="BtnStorage" Style="{StaticResource Btn}" Content="Windows storage settings" Margin="0,0,8,6"/>
            <Button x:Name="BtnHealthHistory" Style="{StaticResource Btn}" Content="Open history file" Margin="0,0,8,6"/>
          </WrapPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel x:Name="HealthPanel"/>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="SMART details">
        <Grid Margin="4,12,4,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <WrapPanel x:Name="SmartPicker"/>
            <TextBlock x:Name="SmartIntro" Margin="2,4,0,8" Foreground="#64748B" FontSize="12.5" TextWrapping="Wrap"
                       Text="The raw data each disk reports about itself. &quot;Watch&quot; means worth keeping an eye on. &quot;Failing&quot; means below the disk's own safety limit."/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SmartPanel" Margin="0,0,8,0"/>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Disk performance">
        <Grid Margin="4,12,4,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="Disk" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#475569"/>
            <ComboBox x:Name="CmbPerfDisk" Width="380" Height="32" Margin="0,0,16,6" VerticalContentAlignment="Center"/>
            <Button x:Name="BtnSpeedTest" Style="{StaticResource Primary}" Content="Run speed test" Margin="0,0,8,6"/>
            <Button x:Name="BtnStop3" Style="{StaticResource Btn}" Content="Stop" IsEnabled="False" Margin="0,0,8,6"/>
          </WrapPanel>
          <TextBlock x:Name="StatusText3" Grid.Row="1" Margin="0,4,0,8" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"
                     Text="Live activity updates every second while this tab is open."/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PerfPanel"/>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Device details">
        <Grid Margin="4,12,4,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <WrapPanel>
            <Button x:Name="BtnDevRefresh" Style="{StaticResource Primary}" Content="Read again" Margin="0,0,8,6"/>
            <Button x:Name="BtnDevCopy" Style="{StaticResource Btn}" Content="Copy all" Margin="0,0,8,6"/>
            <Button x:Name="BtnDevSave" Style="{StaticResource Btn}" Content="Save as text file" Margin="0,0,8,6"/>
            <Button x:Name="BtnDxdiag" Style="{StaticResource Btn}" Content="DirectX Diagnostic (dxdiag)" Margin="0,0,8,6"/>
            <Button x:Name="BtnMsinfo" Style="{StaticResource Btn}" Content="System Information" Margin="0,0,8,6"/>
            <TextBlock x:Name="DevStatus" VerticalAlignment="Center" Margin="6,0,0,6" Foreground="#64748B" FontSize="12"/>
          </WrapPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel x:Name="DevicePanel" Margin="0,0,8,0"/>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Tips &amp; FAQ">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,12,4,10">
          <StackPanel x:Name="HelpPanel" MaxWidth="1000" HorizontalAlignment="Left" Margin="0,0,8,0"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="About">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,12,4,10">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="AboutTitle" Text="Disk Cleanup Helper" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="#475569" Margin="0,6,0,0"
                           Text="A free helper for Windows 10 and 11 that shows what fills your disks and frees space safely. It sends nothing about your PC. Nothing is deleted until you confirm."/>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="BtnInstall" Style="{StaticResource Primary}" Content="Install on this PC" Margin="0,0,8,6"/>
                  <Button x:Name="BtnUninstall" Style="{StaticResource Btn}" Content="Uninstall" Margin="0,0,8,6"/>
                  <Button x:Name="BtnHist" Style="{StaticResource Btn}" Content="Cleanup history" Margin="0,0,8,6"/>
                  <Button x:Name="BtnHelp" Style="{StaticResource Btn}" Content="Read me" Margin="0,0,8,6"/>
                </WrapPanel>
                <TextBlock x:Name="InstallState" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="UpdateStatusText" Foreground="#475569" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="BtnCheckUpdates" Style="{StaticResource Btn}" Content="Check for updates" Margin="0,0,8,6"/>
                </WrapPanel>
                <CheckBox x:Name="ChkAutoUpdate" Content="Check for updates when the app starts" Margin="0,6,0,0"/>
                <TextBlock Foreground="#64748B" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Updates come from the app's GitHub page. Each new version is checked (SHA256 and version number) before it replaces this one."/>
              </StackPanel>
            </Border>
            <StackPanel x:Name="AuthorPanel"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="22,6">
      <TextBox x:Name="LogBox" Height="62" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12" Foreground="#334155" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Border>
  </Grid>
</Window>
